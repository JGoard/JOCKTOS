{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile Debug",
      "type": "shell",
      "command": "docker",
      "args": [
        "run",
        "-it",
        "--rm",
        "-v",
        "${workspaceFolder}:/JOCKTOS",
        "jocktos:latest",
        "/bin/sh",
        "-c",
        "cd /JOCKTOS/jocktos/ && make clean debug && make debug",
      ],
      "icon": {
        "id": "tools",
        "color": "terminal.ansiGreen"
      },
      "options": {
        "statusbar": {
          "color" : "#a8fdbb"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Compile Release",
      "type": "shell",
      "command": "docker",
      "args": [
        "run",
        "-it",
        "--rm",
        "-v",
        "${workspaceFolder}:/JOCKTOS",
        "jocktos:latest",
        "/bin/sh",
        "-c",
        "cd /JOCKTOS/jocktos/ && make clean release && make release",
      ],
      "icon": {
        "id": "tools",
        "color": "terminal.ansiGreen"
      },
      "options": {
        "statusbar": {
          "color" : "#f6fa05"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Flash Device",
      "type": "shell",
      "command": "docker",
      "args": [
        "run",
        "-it",
        "--rm",
        "-v", "/dev/bus/usb:/dev/bus/usb",
        "--privileged",
        "--device=/dev/bus/usb",
        "--device=/dev/ttyACM0",
        "jocktos:latest",
        "/bin/sh",
        "-c",
        "openocd",
        "-f", "/usr/local/share/openocd/openocd.cfg",
        "-f", "/usr/local/share/openocd/interface/stlink.cfg",
        "-f", "/usr/local/share/openocd/scripts/board/st_nucleo_f3.cfg",
        "-f", "/usr/local/share/openocd/scripts/target/stm32f3x.cfg",
        "-s", "/usr/local/share/openocd/scripts",
        "-c", "init",
        "-c", "reset init",
        "-c", "flash write_image erase ./jocktos/build/debug/firmware.elf",
        "-c", "shutdown"
      ],
      "icon": {
        "id": "export",
        "color": "terminal.ansiMagenta"
      },
      "options": {
        "statusbar": {
          "color" : "#ffa9f8"
        }
      },
    },
    {
      "label": "Build Docs",
      "type": "shell",
      "command": "docker",
      "args": [
        "run",
        "-it",
        "--rm",
        "-v",
        "${workspaceFolder}:/JOCKTOS",
        "jocktos:latest",
        "/bin/sh",
        "-c",
        "cd docs && make html && make latexpdf"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "icon": {
        "id": "file-pdf",
        "color": "terminal.ansiCyan"
      },
      "options": {
        "statusbar": {
          "color" : "#a2beee"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Open Dev Shell",
      "type": "shell",
      "command": "docker",
      "args": [
        "run",
        "-it",
        "--rm",
        "-v",
        "${workspaceFolder}:/JOCKTOS",
        "jocktos:latest",
        "/bin/bash"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "icon": {
        "id": "terminal-ubuntu",
        "color": "terminal.ansiRed"
      },
      "options": {
        "statusbar": {
          "color" : "#fab1b1"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "run-qemu-emulator",
      "type": "shell",
      "command": "docker",
      "args": [
        "run",
        "-d",
        "--name",
        "my_qemu_emulator",
        "--privileged",
        "-p",
        "1234:1234",
        "-v",
        "${workspaceFolder}:/JOCKTOS",
        "jocktos:latest",
        "/bin/sh",
        "-c",
        "qemu-system-arm -machine olimex-stm32-h405 -kernel /JOCKTOS/jocktos/build/firmware.elf -monitor none -nographic -serial stdio -s -S"
      ],
      "options": {
        "statusbar": {
          "hide" : true
        }
      },
      "problemMatcher": {
        "owner": "docker",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        }
      }
    },
    {
      "label": "stop-qemu-emulator",
      "type": "shell",
      "command": "docker",
      "args": [
        "rm",
        "-f",
        "my_qemu_emulator"
      ],
      "options": {
        "statusbar": {
          "hide" : true
        }
      },
      "problemMatcher": {
        "owner": "docker",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        }
      }
    }
  ]
}
