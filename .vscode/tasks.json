{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile Debug",
      "type": "shell",
      "command": "docker",
      "args": [
        "run",
        "-it",
        "--rm",
        "-v",
        "${workspaceFolder}:/JOCKTOS",
        "jocktos:latest",
        "/bin/sh",
        "-c",
        "cd /JOCKTOS/jocktos/ && make clean debug && make debug",
      ],
      "icon": {
        "id": "tools",
        "color": "terminal.ansiGreen"
      },
      "options": {
        "statusbar": {
          "color" : "#a8fdbb"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Compile Release",
      "type": "shell",
      "command": "docker",
      "args": [
        "run",
        "-it",
        "--rm",
        "-v",
        "${workspaceFolder}:/JOCKTOS",
        "jocktos:latest",
        "/bin/sh",
        "-c",
        "cd /JOCKTOS/jocktos/ && make clean release && make release",
      ],
      "icon": {
        "id": "tools",
        "color": "terminal.ansiGreen"
      },
      "options": {
        "statusbar": {
          "color" : "#f6fa05"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Bind USB Device",
      "type": "shell",
      "command": "usbipd",
      "args": [
        "bind",    
        "--hardware-id",
        "0483:374b",
      
      ],
      "icon": {
        "id": "bug",
        "color": "terminal.ansiGreen"
      },
      "options": {
        "statusbar": {
          "color": "#f6fa05"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Dock OpenOCD",
      "type": "shell",
      "command": "usbipd",
      "args": [
        "attach",    
        "--wsl",
        "--hardware-id",
        "0483:374b",
      
      ],
      "icon": {
        "id": "bug",
        "color": "terminal.ansiGreen"
      },
      "options": {
        "statusbar": {
          "color": "#f6fa05"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Docker Instance",
      "type": "shell",
      "command": "docker",
      "args": [
        "run",    
        "-i",
        "--expose=3333",
        "--expose=4444",
        "--expose=6666",
        "--privileged",
        "jocktos:latest",
        "sh"
      
      ],
      "icon": {
        "id": "bug",
        "color": "terminal.ansiGreen"
      },
      "options": {
        "statusbar": {
          "color": "#f6fa05"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Flash Device Docker",
      "type": "shell",
      "command": "docker",
      "args": [
        "run",
        "-it",
        "--rm",
        "--privileged",
        "-v",
        "${workspaceFolder}/jocktos/build/debug/firmware.elf:/usr/firmware.elf", 
        "jocktos:latest",
        "openocd",
        "-f", "board/st_nucleo_f3.cfg",
        "-s", "/usr/local/share/openocd/scripts",
        "-c", "init",
        "-c", "reset init",
        "-c", "flash write_image erase /usr/firmware.elf",
        "-c", "shutdown"
      ],
      "icon": {
        "id": "export",
        "color": "terminal.ansiMagenta"
      },
      "options": {
        "statusbar": {
          "color" : "#ffa9f8"
        }
      },
      
    },
    {
      "label": "Flash Device Local",
      "type": "shell",
      "command": "openocd",
      "args": [
        "-f",
        "board/st_nucleo_f3.cfg",
        "-c",
        "init",
        "-c",
        "reset init",
        "-c",
        "flash write_image erase ./jocktos/build/debug/firmware.elf",
        "-c",
        "shutdown"
      ],
      "icon": {
        "id": "export",
        "color": "terminal.ansiMagenta"
      },
      "options": {
        "statusbar": {
          "color": "#ffa9f8"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Run Unit Tests",
      "type": "shell",
      "command": "cd ${workspaceFolder}/jocktos/test; make run-tests",
      "icon": {
        "id": "run",
        "color": "terminal.ansiWhite"
      },
      "options": {
        "statusbar": {
          "color" : "#ffffff"
        }
      }
    },    
    {
      "label": "Build Docs",
      "type": "shell",
      "command": "docker",
      "args": [
        "run",
        "-it",
        "--rm",
        "-v",
        "${workspaceFolder}:/JOCKTOS",
        "jocktos:latest",
        "/bin/sh",
        "-c",
        "cd docs && make html && make latexpdf"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "icon": {
        "id": "file-pdf",
        "color": "terminal.ansiCyan"
      },
      "options": {
        "statusbar": {
          "color" : "#a2beee"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Open Dev Shell",
      "type": "shell",
      "command": "docker",
      "args": [
        "run",
        "-it",
        "--rm",
        "-v",
        "${workspaceFolder}:/JOCKTOS",
        "jocktos:latest",
        "/bin/bash"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "icon": {
        "id": "terminal-ubuntu",
        "color": "terminal.ansiRed"
      },
      "options": {
        "statusbar": {
          "color" : "#fab1b1"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "run-qemu-emulator",
      "type": "shell",
      "command": "docker",
      "args": [
        "run",
        "-d",
        "--name",
        "my_qemu_emulator",
        "--privileged",
        "-p",
        "1234:1234",
        "-v",
        "${workspaceFolder}:/JOCKTOS",
        "jocktos:latest",
        "/bin/sh",
        "-c",
        "qemu-system-arm -machine olimex-stm32-h405 -kernel /JOCKTOS/jocktos/build/firmware.elf -monitor none -nographic -serial stdio -s -S"
      ],
      "options": {
        "statusbar": {
          "hide" : true
        }
      },
      "problemMatcher": {
        "owner": "docker",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        }
      }
    },
    {
      "label": "stop-qemu-emulator",
      "type": "shell",
      "command": "docker",
      "args": [
        "rm",
        "-f",
        "my_qemu_emulator"
      ],
      "options": {
        "statusbar": {
          "hide" : true
        }
      },
      "problemMatcher": {
        "owner": "docker",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        }
      }
    },
    {
      "label": "build current unit test",
      "type": "shell",
      "command": "cd ${workspaceFolder}/jocktos/test; make build/${fileBasenameNoExtension}.test",
      "options": {
        "statusbar": {
          "hide" : true
        }
      },
    }
  ]
}

